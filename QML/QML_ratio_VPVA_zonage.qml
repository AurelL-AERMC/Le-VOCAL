                      <Option name="expression" type="QString" value="if(  &quot;prelev_sum&quot; > coalesce(&quot;autor_sum&quot;,0),with_variable(&#xd;&#xa;  'maxp', aggregate(@layer,'max', coalesce(&quot;prelev_sum&quot;,0)),&#xd;&#xa;  with_variable(&#xd;&#xa;    'maxa', aggregate(@layer,'max', coalesce(&quot;autor_sum&quot;,0)),&#xd;&#xa;    with_variable(&#xd;&#xa;      'gmax', if(@maxa > @maxp, @maxa, @maxp),&#xd;&#xa;      with_variable(&#xd;&#xa;        'base', scale_linear(&#xd;&#xa;          sqrt(coalesce(&quot;autor_sum&quot;,0)),&#xd;&#xa;          0,&#xd;&#xa;          sqrt(if(@gmax &lt; 1, 1, @gmax)),&#xd;&#xa;          4000,&#xd;&#xa;          20000&#xd;&#xa;        ),&#xd;&#xa;        with_variable(&#xd;&#xa;          'ratio', if(coalesce(&quot;autor_sum&quot;,0) > 0, coalesce(&quot;prelev_sum&quot;,0) / coalesce(&quot;autor_sum&quot;,0), 0),&#xd;&#xa;          with_variable(&#xd;&#xa;            'cap', 3,&#xd;&#xa;            -- si on a un autorisé > 0 : on applique la racine du ratio (pour lisser) multipliée par la taille de l'autorisé&#xd;&#xa;            -- si autorisé = 0 (ou null) : on retombe sur une normalisation classique par gmax sur prelev&#xd;&#xa;            if(&#xd;&#xa;              coalesce(&quot;autor_sum&quot;,0) > 0,&#xd;&#xa;              @base * sqrt( if(@ratio > @cap, @cap, @ratio) ),&#xd;&#xa;              scale_linear(&#xd;&#xa;                sqrt(coalesce(&quot;prelev_sum&quot;,0)),&#xd;&#xa;                0,&#xd;&#xa;                sqrt(if(@gmax &lt; 1, 1, @gmax)),&#xd;&#xa;                4000,&#xd;&#xa;                10000&#xd;&#xa;              )&#xd;&#xa;            )&#xd;&#xa;          )&#xd;&#xa;        )&#xd;&#xa;      )&#xd;&#xa;    )&#xd;&#xa;  )&#xd;&#xa;),0)"/>
                      <Option name="type" type="int" value="3"/>
                    </Option>
